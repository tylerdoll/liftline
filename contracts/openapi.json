  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Exercise": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "muscle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "equipment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "id",
          "name",
          "muscle",
          "equipment"
        ],
        "additionalProperties": false
      },
      "Plan": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "days": {
            "minItems": 1,
            "maxItems": 14,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "dayOfWeek": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "position": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "exercises": {
                  "maxItems": 30,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "exerciseId": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                      },
                      "plannedSets": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "position": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "repMin": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 50
                      },
                      "repMax": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 50
                      },
                      "perSide": {
                        "type": "boolean"
                      },
                      "supersetGroup": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "supersetPosition": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 8
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "restSeconds": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3600
                      }
                    },
                    "required": [
                      "exerciseId",
                      "plannedSets",
                      "position",
                      "repMin",
                      "repMax",
                      "perSide",
                      "supersetGroup",
                      "supersetPosition",
                      "restSeconds"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "name",
                "dayOfWeek",
                "position",
                "exercises"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "days"
        ],
        "additionalProperties": false
      },
      "Session": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "planId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,100}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "dayId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,100}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "dayName": {
            "type": "string",
            "maxLength": 160
          },
          "planName": {
            "type": "string",
            "maxLength": 160
          },
          "workoutDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "startedAt": {
            "type": "number",
            "minimum": 0
          },
          "resumedAt": {
            "type": "number",
            "minimum": 0
          },
          "elapsedBeforePause": {
            "type": "number",
            "minimum": 0
          },
          "exercises": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "muscle": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "equipment": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "plannedSets": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "position": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "repMin": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 50
                },
                "repMax": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 50
                },
                "perSide": {
                  "type": "boolean"
                },
                "supersetGroup": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "supersetPosition": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 8
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "restSeconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3600
                },
                "sets": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "setNumber": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      "reps": {
                        "anyOf": [
                          {
                            "type": "string",
                            "const": ""
                          },
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 50
                          }
                        ]
                      },
                      "weight": {
                        "anyOf": [
                          {
                            "type": "string",
                            "const": ""
                          },
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 2000
                          }
                        ]
                      }
                    },
                    "required": [
                      "setNumber",
                      "reps",
                      "weight"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "name",
                "muscle",
                "equipment",
                "plannedSets",
                "position",
                "repMin",
                "repMax",
                "perSide",
                "supersetGroup",
                "supersetPosition",
                "restSeconds",
                "sets"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "planId",
          "dayId",
          "dayName",
          "planName",
          "workoutDate",
          "startedAt",
          "resumedAt",
          "elapsedBeforePause",
          "exercises"
        ],
        "additionalProperties": false
      },
      "Mutation": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "value": {}
        },
        "required": [
          "operationId",
          "expectedRevision",
          "value"
        ],
        "additionalProperties": false
      }
    }
  }
}