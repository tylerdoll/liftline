{
  "name": "liftline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node --import tsx scripts/baseline-server.ts",
    "test": "node --import tsx --test tests/contracts.test.ts baseline/tests/backup-retention.test.mjs",
    "test:browser": "playwright test",
    "dev:aws": "node --import tsx scripts/aws-server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint api domain contracts frontend infra scripts tests",
    "build": "vite build && node --import tsx scripts/bundle.ts",
    "synth": "node --import tsx infra/app.ts",
    "test:unit": "node --import tsx --test tests/recovery.test.ts tests/time.test.ts tests/infra.test.ts tests/progression-parity.test.ts",
    "test:aws": "node --import tsx --test tests/aws.integration.ts tests/migration.integration.ts tests/restore.integration.ts",
    "test:aws-browser": "playwright test -c playwright.aws.config.ts",
    "manifest": "node --import tsx scripts/manifest.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm synth && pnpm test:unit && pnpm test:aws && pnpm test:browser && pnpm test:aws-browser",
    "contracts:generate": "node --import tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1131.0",
    "@aws-sdk/client-dynamodb": "3.1131.0",
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/lib-dynamodb": "3.1131.0",
    "@js-temporal/polyfill": "0.5.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "aws-cdk": "2.1141.0",
    "aws-cdk-lib": "2.269.0",
    "constructs": "10.8.1",
    "esbuild": "0.27.7",
    "eslint": "9.39.5",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
